<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Phase 1: Logo Entry with Spring Scale -->
    <Transition
        android:id="@+id/transition1"
        app:constraintSetStart="@id/start"
        app:constraintSetEnd="@id/phase1"
        app:duration="700"
        app:autoTransition="animateToEnd">
        <KeyFrameSet>
            <KeyAttribute
                app:motionTarget="@+id/logo"
                app:framePosition="85"
                android:scaleX="1.1"
                android:scaleY="1.1" />
        </KeyFrameSet>
    </Transition>

    <!-- Phase 2: Circular Reveal + Burst Accents + BG Texture -->
    <Transition
        android:id="@+id/transition2"
        app:constraintSetStart="@id/phase1"
        app:constraintSetEnd="@id/phase2"
        app:duration="600"
        app:autoTransition="animateToEnd"
        app:motionInterpolator="fastOutSlowIn">
        <KeyFrameSet>
            <!-- Burst Accents animation -->
            <KeyAttribute
                app:motionTarget="@+id/accent1"
                app:framePosition="50"
                android:alpha="0.8"
                android:scaleX="4"
                android:scaleY="4" />
            <KeyAttribute
                app:motionTarget="@+id/accent2"
                app:framePosition="70"
                android:alpha="0.6"
                android:scaleX="6"
                android:scaleY="6" />
        </KeyFrameSet>
    </Transition>

    <!-- Phase 3: Logo Move Up with Overshoot + Shimmer Sweep -->
    <Transition
        android:id="@+id/transition3"
        app:constraintSetStart="@id/phase2"
        app:constraintSetEnd="@id/phase3"
        app:duration="600"
        app:autoTransition="animateToEnd"
        app:motionInterpolator="fastOutSlowIn">
        <KeyFrameSet>
            <KeyPosition
                app:motionTarget="@+id/logo"
                app:framePosition="80"
                app:keyPositionType="pathRelative"
                app:percentY="-0.05" />

            <!-- Shimmer movement -->
            <KeyAttribute
                app:motionTarget="@+id/shimmer"
                app:framePosition="0"
                android:alpha="0"
                android:translationX="-400dp" />
            <KeyAttribute
                app:motionTarget="@+id/shimmer"
                app:framePosition="50"
                android:alpha="0.6" />
            <KeyAttribute
                app:motionTarget="@+id/shimmer"
                app:framePosition="100"
                android:alpha="0"
                android:translationX="800dp" />
        </KeyFrameSet>
    </Transition>

    <!-- Phase 4: Staggered Content Reveal -->
    <Transition
        android:id="@+id/transition4"
        app:constraintSetStart="@id/phase3"
        app:constraintSetEnd="@id/end"
        app:duration="800"
        app:autoTransition="animateToEnd">
        <KeyFrameSet>
            <KeyAttribute
                app:motionTarget="@+id/appName"
                app:framePosition="20"
                android:alpha="0.5"
                android:scaleX="1.05"
                android:scaleY="1.05" />

            <KeyAttribute
                app:motionTarget="@+id/tagline"
                app:framePosition="30"
                android:alpha="0"
                android:translationY="30dp" />
            <KeyAttribute
                app:motionTarget="@+id/tagline"
                app:framePosition="80"
                android:alpha="1"
                android:translationY="0dp" />

            <KeyAttribute
                app:motionTarget="@+id/version"
                app:framePosition="60"
                android:alpha="0" />
        </KeyFrameSet>
    </Transition>

    <!-- Constraint Sets -->

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/logo">
            <Layout
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0.6"
                android:scaleY="0.6" />
        </Constraint>

        <Constraint android:id="@id/bgReveal">
            <Layout
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0.1"
                android:scaleY="0.1" />
        </Constraint>

        <Constraint android:id="@id/bgDots">
            <PropertySet android:alpha="0" />
        </Constraint>

        <Constraint android:id="@id/accent1">
            <Transform android:scaleX="0.1" android:scaleY="0.1" />
            <PropertySet android:alpha="0" />
        </Constraint>
        <Constraint android:id="@id/accent2">
            <Transform android:scaleX="0.1" android:scaleY="0.1" />
            <PropertySet android:alpha="0" />
        </Constraint>

        <Constraint android:id="@id/logoGlow">
            <PropertySet android:alpha="0" />
        </Constraint>

        <Constraint android:id="@id/appName">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="40dp" />
        </Constraint>
        <Constraint android:id="@id/tagline">
            <PropertySet android:alpha="0" />
        </Constraint>
        <Constraint android:id="@id/version">
            <PropertySet android:alpha="0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/phase1" app:deriveConstraintsFrom="@id/start">
        <Constraint android:id="@id/logo">
            <PropertySet android:alpha="1" />
            <Transform
                android:scaleX="1.0"
                android:scaleY="1.0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/phase2" app:deriveConstraintsFrom="@id/phase1">
        <Constraint android:id="@id/logo">
            <Transform
                android:scaleX="1.15"
                android:scaleY="1.15" />
        </Constraint>
        <Constraint android:id="@id/bgReveal">
            <Layout
                android:layout_width="2500dp"
                android:layout_height="2500dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <PropertySet android:alpha="1" />
            <Transform
                android:scaleX="1.2"
                android:scaleY="1.2" />
        </Constraint>
        <Constraint android:id="@id/bgDots">
            <PropertySet android:alpha="0.4" />
        </Constraint>
        <Constraint android:id="@id/logoGlow">
            <PropertySet android:alpha="1" />
            <Transform
                android:scaleX="1.2"
                android:scaleY="1.2" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/phase3" app:deriveConstraintsFrom="@id/phase2">
        <Constraint android:id="@id/logo">
            <Layout
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.3" />
            <Transform
                android:scaleX="0.95"
                android:scaleY="0.95" />
        </Constraint>
        <Constraint android:id="@id/logoGlow">
            <PropertySet android:alpha="0.5" />
            <Transform
                android:scaleX="1.0"
                android:scaleY="1.0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end" app:deriveConstraintsFrom="@id/phase3">
        <Constraint android:id="@id/appName">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
        <Constraint android:id="@id/tagline">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
        <Constraint android:id="@id/version">
            <PropertySet android:alpha="1" />
        </Constraint>
    </ConstraintSet>

</MotionScene>